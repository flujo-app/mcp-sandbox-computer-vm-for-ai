{
  "mcpServers": {
    "sandbox-computer-fly": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "mcp-sandbox-computer-vm-for-ai",
        "--backend",
        "fly"
      ],
      "env": {
        "ENABLE_LIFECYCLE_TOOLS": "true",
        "AUTO_INSTALL_FLYCTL": "true"
      }
    }
  }
}
